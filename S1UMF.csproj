<Project Sdk="Microsoft.NET.Sdk">
  <!-- Schedule I Unofficial Mod Fixes (S1UMF): version-gated fixes for other mods on Schedule I 0.4.7 (beta branch, IL2CPP).
       Each fix is gated on the exact version of the mod it repairs and stands down when that mod updates. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>S1UMF</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GameDir Condition="'$(GameDir)' == ''">$(S1_GAME_DIR)</GameDir>
    <Interop>$(GameDir)/MelonLoader/Il2CppAssemblies</Interop>
    <ML>$(GameDir)/MelonLoader/net6</ML>
  </PropertyGroup>
  <!-- Developer build: dotnet build -p:Dev=true adds the crash-chasing switches (see DEVELOPING.md). -->
  <PropertyGroup Condition="'$(Dev)' == 'true'">
    <DefineConstants>$(DefineConstants);S1UMF_DEV</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(ML)/MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ML)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(ML)/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(ML)/Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(Interop)/Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Interop)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AIModule"><HintPath>$(Interop)/UnityEngine.AIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppFishNet.Runtime"><HintPath>$(Interop)/Il2CppFishNet.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(Interop)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppScheduleOne.Core"><HintPath>$(Interop)/Il2CppScheduleOne.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Interop)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Interop)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireGameDir" BeforeTargets="ResolveAssemblyReferences" Condition="'$(GameDir)' == ''">
    <Error Text="Set the Schedule I folder: dotnet build -p:GameDir=&quot;/path/to/Schedule I&quot; (or the S1_GAME_DIR environment variable). It needs MelonLoader installed and run once." />
  </Target>
</Project>
